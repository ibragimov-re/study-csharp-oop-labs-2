' ==============================
' HashNode<T>
' ==============================
class HashNode<T> {
    -Key: int
    -Value: T
    -Next: HashNode<T>

    +HashNode(val: T)
    +ToString(): string
}

HashNode --> HashNode : Next
HashNode --> Organization

' ==============================
' MyCollection<T>
' ==============================
class MyCollection {
    -table: HashNode<T>[]

    +Count: int
    +Capacity: int
    +IsSynchronized: bool
    +SyncRoot: object

    +MyCollection()
    +MyCollection(capacity: int)
    +MyCollection(col: MyCollection<T>)

    +Add(item: T): void
    +AddRange(items: T[]): void
    +Remove(item: T): bool
    +RemoveRange(items: T[]): void
    +Find(name: string): T
    +DeepCopy(): MyCollection<T>
    +ShallowCopy(): MyCollection<T>
    +Clear(): void
    +CopyTo(array: Array, index: int): void

    +GetEnumerator(): IEnumerator<T>
    

}

MyCollection --> HashNode
MyCollection --> MyEnumerator

' ==============================
' MyEnumerator<T>
' ==============================
class MyEnumerator {
    -collection: MyCollection<T>
    -index: int
    -currentNode: HashNode<T>

    +Current: T
    +MoveNext(): bool
    +Reset(): void
    +Dispose(): void
}

MyEnumerator --> MyCollection
MyEnumerator --> HashNode

@enduml