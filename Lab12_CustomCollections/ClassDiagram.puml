@startuml
top to bottom direction

' ==============================
' Классы организации
' ==============================
class Organization {
    #MinNameLength: int
    #MaxNameLength: int
    #MaxEmployeesCount: int

    #name: string
    #employeesCount: int

    +Name: string
    +EmployeesCount: int

    +Organization()
    +Organization(orgName: string, empCount: int)
    +Organization(otherOrg: Organization)

    +ShowNonVirtual(): void
    +Show(): void
    +Init(): void
    +RandomInit(): void
    +Equals(obj: object): bool
    +CompareTo(obj: object): int
}

